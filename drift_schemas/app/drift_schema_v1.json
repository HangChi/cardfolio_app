  "fixed_sql": [
    {
      "name": "card_definitions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_definitions\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"city\" TEXT NULL, \"issuer\" TEXT NULL, \"issued_at\" TEXT NULL, \"code\" TEXT NULL, \"notes\" TEXT NULL, \"version\" INTEGER NOT NULL DEFAULT 1 CHECK(\"version\" > 0), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "card_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_items\" (\"id\" TEXT NOT NULL, \"definition_id\" TEXT NOT NULL REFERENCES card_definitions (id), \"quantity\" INTEGER NOT NULL DEFAULT 1 CHECK(\"quantity\" > 0), \"version\" INTEGER NOT NULL DEFAULT 1 CHECK(\"version\" > 0), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "card_images",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_images\" (\"id\" TEXT NOT NULL, \"card_item_id\" TEXT NOT NULL REFERENCES card_items (id), \"kind\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL UNIQUE, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"checksum\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
