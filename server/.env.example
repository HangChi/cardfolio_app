# Supabase 项目根地址，例如 https://project.supabase.co 或自托管地址。
# 非 localhost 地址必须使用 https，避免密钥明文传输。
SUPABASE_URL=https://your-supabase.example.com
SUPABASE_PUBLISHABLE_KEY=replace-with-sb-publishable-key
SUPABASE_SECRET_KEY=replace-with-sb-secret-key

# 旧项目仍可使用 SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY；不要同时配置两套。

# 仅当请求一定经过可信反向代理时启用，用于按真实客户端 IP 限流。
TRUST_PROXY=true
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=900000
# /readyz 每个限流窗口允许的请求数（防上游放大）。
READYZ_RATE_LIMIT=300
MAX_JSON_BYTES=2097152
MAX_ATTACHMENT_BYTES=67108864
UPSTREAM_TIMEOUT_MS=30000
# 单次 push 批次的总时长预算，必须小于网关 requestTimeout(120s) 与 Nginx proxy_read_timeout。
PUSH_DEADLINE_MS=100000
# 云端导出单次返回的最大实体数。
EXPORT_MAX_ENTITIES=10000
